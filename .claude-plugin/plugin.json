{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "devops-status-mcp-server",
  "version": "0.8.3",
  "description": "Check vendor status pages, inspect SSL/TLS certificates, verify DNS propagation, and get incident-response playbooks.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/devops-status-mcp-server#readme",
  "repository": "git+https://github.com/cyanheads/devops-status-mcp-server.git",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "devops",
    "status-page",
    "statuspage",
    "incident-response",
    "ssl-certificate",
    "dns",
    "typescript",
    "bun",
    "stdio",
    "streamable-http"
  ],
  "mcpServers": {
    "devops-status-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/devops-status-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
